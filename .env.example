DATABASE_URL=postgresql://uke:change-me@host.docker.internal:5432/uke
SESSION_SECRET=replace-with-a-long-random-value

# UKE <-> n8n (use different long random values outside Git)
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
# Existing host app; use http://uke:3000 when running the full Compose stack.
UKE_API_BASE_URL=http://host.docker.internal:3000
UKE_WEBHOOK_SECRET=replace-with-a-long-random-value

# Dedicated n8n PostgreSQL database (not the UKE application database)
DB_POSTGRESDB_HOST=n8n-postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=replace-with-a-long-random-value

# Account-specific credentials; never reuse a prefix across Dekoral and ACC.
# Mail provider events are normalized by n8n and signed with the account secret.
DEKORAL_MAIL_WEBHOOK_SECRET=
ACC_MAIL_WEBHOOK_SECRET=
DEKORAL_MAIL_ACCESS_TOKEN=
ACC_MAIL_ACCESS_TOKEN=
# For SMTP/IMAP use <PREFIX>_PASSWORD instead of ACCESS_TOKEN.
DEKORAL_WA_APP_SECRET=
DEKORAL_WA_VERIFY_TOKEN=
DEKORAL_WA_ACCESS_TOKEN=
ACC_WA_APP_SECRET=
ACC_WA_VERIFY_TOKEN=
ACC_WA_ACCESS_TOKEN=
# Test reply worker: explicit recipient and live-send switch are both required.
ACC_WA_TEST_RECIPIENT=
ACC_WA_LIVE_SEND=false
